# btrfs-patrol configuration.
#
# Copy this file to /etc/btrfs-patrol/config.toml, adjust it, then run
# 'sudo btrfs-patrol check'. The values below are the defaults, which match
# Fedora's installer layout.

[filesystem]
# Block device holding the btrfs filesystem, or "auto" to use the device
# mounted at /. Examples: "/dev/nvme0n1p3", "/dev/mapper/luks-<uuid>".
device = "auto"

# Subvolume mounted at /, as a path relative to the top-level subvolume.
# Fedora's installer names it "root".
root_subvolume = "root"

# Top-level subvolume that holds the snapshots. It must NOT be inside the root
# subvolume, or a rollback would move the snapshots away together with root.
snapshots_subvolume = "snapshots"

# Where snapshots_subvolume is mounted.
snapshots_dir = "/.snapshots"

[retention]
# How many snapshots of root to keep before the oldest are pruned, and the
# default for other subvolumes. Snapshots marked with 'btrfs-patrol keep' don't
# count toward this limit.
max_snapshots = 50

# Other subvolumes to snapshot besides root: one [subvolumes.<name>] table each.
# The name is what 'btrfs-patrol list' shows and 'subvolume=<name>' selects;
# "root" is taken. Each must be a btrfs subvolume on the same filesystem as /,
# either mounted on its own (by subvol= in /etc/fstab, as Fedora mounts /home)
# or inside another subvolume. A subvolume is rolled back on its own: rolling
# back root leaves /home alone, and the other way round.
#
# [subvolumes.home]
# path = "/home"          # its mount point, or its path inside another subvolume
# max_snapshots = 20      # snapshots of it to keep (default: retention.max_snapshots)
# timer = true            # in the daily snapshot (default: true)
# dnf = false             # in the snapshots dnf takes, too (default: false)

[dnf]
# Take a snapshot before each dnf5 transaction (needs libdnf5-plugin-actions).
pre_snapshot = true
# Also take one after each transaction.
post_snapshot = false

[output]
# "auto" (color only on a terminal, and not when NO_COLOR is set), "always"
# or "never".
color = "auto"
